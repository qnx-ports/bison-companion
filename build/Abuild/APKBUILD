23318ed54a303f5c5f928dc55597a141fbf7819d9f2e5116d5bcb921b8d535c3c92d7f1ad1819520d92c91508f142f54c71d932388bc58a3789e0b7cf2e27c6e  disable-snprintf.patch
"
